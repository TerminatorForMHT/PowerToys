<Window
    x:Class="LightSwitch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent title bar (draggable area registered via SetTitleBar) -->
        <Grid x:Name="TitleBarGrid" Height="32" Canvas.ZIndex="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="/Assets/Square44x44Logo.png" Width="16" Height="16" />
                <TextBlock Text="LightSwitch 设置" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Fluent settings pattern (Win11 Settings / Notepad settings): the page
             header and content form a left-anchored column with a width cap.
             On wide/maximized windows the column stays left-aligned and readable
             instead of stretching or centering; the scrollbar keeps to the
             window's right edge. -->
        <TextBlock Grid.Row="1" Text="设置" Margin="24,8,24,16"
                   Style="{ThemeResource TitleTextBlockStyle}" />

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left" Margin="24,0,24,24">
                    <TextBlock Text="计划模式" FontWeight="SemiBold" />
                    <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="关闭" />
                        <ComboBoxItem Content="固定时间" />
                        <ComboBoxItem Content="日出到日落" />
                        <ComboBoxItem Content="跟随夜览" />
                    </ComboBox>

                    <StackPanel x:Name="FixedHoursPanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,8,*">
                            <TimePicker x:Name="LightTimePicker" Header="浅色开始时间" />
                            <TimePicker x:Name="DarkTimePicker" Grid.Column="2" Header="深色开始时间" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SunPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="LatitudeBox" Header="纬度" PlaceholderText="留空则自动使用系统定位" TextChanged="OnSunInputsChanged" />
                        <TextBox x:Name="LongitudeBox" Header="经度" PlaceholderText="留空则自动使用系统定位" TextChanged="OnSunInputsChanged" />
                        <Button x:Name="GetLocationButton" Content="使用系统定位" HorizontalAlignment="Left" Click="OnGetLocationClick" />
                        <TextBlock x:Name="SunTimesText" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,8,*">
                            <NumberBox x:Name="SunriseOffsetBox" Header="日出偏移（分钟）" Minimum="-720" Maximum="720" SpinButtonPlacementMode="Inline" ValueChanged="OnSunOffsetChanged" />
                            <NumberBox x:Name="SunsetOffsetBox" Grid.Column="2" Header="日落偏移（分钟）" Minimum="-720" Maximum="720" SpinButtonPlacementMode="Inline" ValueChanged="OnSunOffsetChanged" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="NightLightHint" Text="跟随系统夜览状态，无需额外设置。" Visibility="Collapsed" />

                    <TextBlock Text="应用范围" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="SystemToggle" Header="系统主题（任务栏、开始菜单）" />
                    <ToggleSwitch x:Name="AppsToggle" Header="应用主题" />

                    <TextBlock Text="桌面壁纸" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="WallpaperToggle" Header="随主题切换壁纸" Toggled="OnWallpaperToggled" />
                    <StackPanel x:Name="WallpaperPanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox x:Name="LightWallpaperBox" Header="浅色模式壁纸" PlaceholderText="选择浅色模式使用的图片" IsReadOnly="True" />
                            <Button x:Name="PickLightWallpaperButton" Grid.Column="2" Content="浏览..." VerticalAlignment="Bottom" Click="OnPickLightWallpaper" />
                        </Grid>
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox x:Name="DarkWallpaperBox" Header="深色模式壁纸" PlaceholderText="选择深色模式使用的图片" IsReadOnly="True" />
                            <Button x:Name="PickDarkWallpaperButton" Grid.Column="2" Content="浏览..." VerticalAlignment="Bottom" Click="OnPickDarkWallpaper" />
                        </Grid>
                        <TextBlock Text="切换主题时将同时更换桌面壁纸。支持 JPG / PNG / BMP。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="启动" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="StartupToggle" Header="开机时自动启动" />

                    <TextBlock Text="切换快捷键" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox x:Name="HotkeyCapture" IsReadOnly="True" PlaceholderText="点击后按下快捷键" KeyDown="OnHotkeyKeyDown" />
                        <Button x:Name="ClearHotkeyButton" Grid.Column="2" Content="清除" Click="OnClearHotkeyClick" />
                    </Grid>

                    <!-- Save right-aligned (Apply pattern from Fluent settings pages);
                         dismissal is via the window X. -->
                    <Grid Margin="0,12,0,0">
                        <Button Content="保存" Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Right" MinWidth="100" Click="OnSaveClick" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
