<Window
    x:Class="LightSwitch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Bottom-up slide used when switching nav sections (native transition) -->
            <TransitionCollection x:Key="SlideUpTransition">
                <EntranceThemeTransition FromVerticalOffset="56" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent title bar (draggable area registered via SetTitleBar) -->
        <Grid x:Name="TitleBarGrid" Height="32" Canvas.ZIndex="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="/Assets/Square44x44Logo.png" Width="16" Height="16" />
                <TextBlock Text="LightSwitch" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Win11 Settings / Auto Dark Mode structure: fixed left navigation pane
             (never collapses) + capped content column; footer item at pane bottom -->
        <NavigationView Grid.Row="1" x:Name="NavView"
                        PaneDisplayMode="Left" OpenPaneLength="200"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="计划模式" Tag="mode">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="应用范围" Tag="scope">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="桌面壁纸" Tag="wallpaper">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PageTitle" Text="计划模式" Margin="24,12,24,8"
                               Style="{ThemeResource TitleTextBlockStyle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="24,0,24,24" Spacing="16">
                            <!-- Section: schedule mode -->
                            <StackPanel x:Name="SectionMode" Spacing="16" Transitions="{StaticResource SlideUpTransition}">
                                <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
                                    <ComboBoxItem Content="关闭" />
                                    <ComboBoxItem Content="固定时间" />
                                    <ComboBoxItem Content="日出到日落" />
                                    <ComboBoxItem Content="跟随夜览" />
                                </ComboBox>

                                <StackPanel x:Name="FixedHoursPanel" Spacing="8" Visibility="Collapsed">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TimePicker x:Name="LightTimePicker" Header="浅色开始时间" TimeChanged="OnScheduleChanged" />
                                        <TimePicker x:Name="DarkTimePicker" Grid.Column="2" Header="深色开始时间" TimeChanged="OnScheduleChanged" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="SunPanel" Spacing="8" Visibility="Collapsed">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TextBox x:Name="LatitudeBox" Header="纬度" PlaceholderText="留空则自动使用系统定位" TextChanged="OnSunInputsChanged" />
                                        <TextBox x:Name="LongitudeBox" Grid.Column="2" Header="经度" PlaceholderText="留空则自动使用系统定位" TextChanged="OnSunInputsChanged" />
                                    </Grid>
                                    <Button x:Name="GetLocationButton" Content="使用系统定位" HorizontalAlignment="Left" Click="OnGetLocationClick" />
                                    <TextBlock x:Name="SunTimesText" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <NumberBox x:Name="SunriseOffsetBox" Header="日出偏移（分钟）" Minimum="-720" Maximum="720" SpinButtonPlacementMode="Inline" ValueChanged="OnSunOffsetChanged" />
                                        <NumberBox x:Name="SunsetOffsetBox" Grid.Column="2" Header="日落偏移（分钟）" Minimum="-720" Maximum="720" SpinButtonPlacementMode="Inline" ValueChanged="OnSunOffsetChanged" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="NightLightHint" Text="跟随系统夜览状态，无需额外设置。" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Section: theme scope -->
                            <StackPanel x:Name="SectionScope" Spacing="8" Visibility="Collapsed" Transitions="{StaticResource SlideUpTransition}">
                                <ToggleSwitch x:Name="SystemToggle" Header="系统主题（任务栏、开始菜单）" Toggled="OnSettingToggled" />
                                <ToggleSwitch x:Name="AppsToggle" Header="应用主题" Toggled="OnSettingToggled" />
                            </StackPanel>

                            <!-- Section: wallpaper -->
                            <StackPanel x:Name="SectionWallpaper" Spacing="8" Visibility="Collapsed" Transitions="{StaticResource SlideUpTransition}">
                                <ToggleSwitch x:Name="WallpaperToggle" Header="随主题切换壁纸" Toggled="OnWallpaperToggled" />
                                <StackPanel x:Name="WallpaperPanel" Spacing="8" Visibility="Collapsed">
                                    <ToggleSwitch x:Name="PerMonitorToggle" Header="多显示器分别设置壁纸" Toggled="OnPerMonitorToggled" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox x:Name="LightWallpaperBox" Header="浅色壁纸" PlaceholderText="选择浅色模式使用的图片" IsReadOnly="True" />
                                        <Button x:Name="PickLightWallpaperButton" Grid.Column="2" Content="浏览..." VerticalAlignment="Bottom" Click="OnPickLightWallpaper" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox x:Name="DarkWallpaperBox" Header="深色壁纸" PlaceholderText="选择深色模式使用的图片" IsReadOnly="True" />
                                        <Button x:Name="PickDarkWallpaperButton" Grid.Column="2" Content="浏览..." VerticalAlignment="Bottom" Click="OnPickDarkWallpaper" />
                                    </Grid>
                                    <!-- Rows for monitors 2..N are generated in code-behind -->
                                    <StackPanel x:Name="MonitorWallpaperPanel" Spacing="8" Visibility="Collapsed" />
                                    <TextBlock x:Name="WallpaperHint" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Section: general (startup + hotkey + tray + notifications) -->
                            <StackPanel x:Name="SectionGeneral" Spacing="8" Visibility="Collapsed" Transitions="{StaticResource SlideUpTransition}">
                                <ToggleSwitch x:Name="StartupToggle" Header="开机时自动启动" Toggled="OnSettingToggled" />
                                <ToggleSwitch x:Name="NotificationsToggle" Header="切换主题时显示系统通知" Toggled="OnSettingToggled" />
                                <ComboBox x:Name="TrayDoubleClickCombo" Header="双击托盘图标" SelectedIndex="0" SelectionChanged="OnTrayActionChanged">
                                    <ComboBoxItem Content="切换主题" />
                                    <ComboBoxItem Content="打开设置" />
                                </ComboBox>
                                <TextBlock Text="切换快捷键" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox x:Name="HotkeyCapture" IsReadOnly="True" PlaceholderText="点击后按下快捷键" KeyDown="OnHotkeyKeyDown" />
                                    <Button x:Name="ClearHotkeyButton" Grid.Column="2" Content="清除" Click="OnClearHotkeyClick" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Apply bar: settings take effect only after confirmation -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Padding="24,12,24,12">
                        <Button x:Name="ApplyButton" Content="应用" MinWidth="100"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnApplyClick" />
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
