<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LightSwitch</RootNamespace>
    <AssemblyName>LightSwitch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LightSwitch.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Acquire the Windows SDK reference pack from NuGet (no local Windows Kits required to compile) -->
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <!-- LibraryImport source generation and WinRT AOT generation require unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Single-project MSIX -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Ship the Windows App Runtime inside the package (no separate runtime install) -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <!-- This standalone project manages its own package versions, decoupled from the PowerToys repo -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Do not inherit repo-level build tooling (analyzers, stylecop, central props) -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
