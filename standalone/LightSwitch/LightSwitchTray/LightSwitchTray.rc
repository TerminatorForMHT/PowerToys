#include "resource.h"
#include "windows.h"

IDI_LIGHTSWITCH ICON "LightSwitch.ico"

IDR_TRAY_MENU MENU
BEGIN
    POPUP "LightSwitch"
    BEGIN
        MENUITEM "Toggle Theme Now",            IDM_TOGGLE
        POPUP "Mode"
        BEGIN
            MENUITEM "Off",                     IDM_MODE_OFF
            MENUITEM "Fixed Hours",             IDM_MODE_FIXED
            MENUITEM "Sunset to Sunrise",       IDM_MODE_SUN
            MENUITEM "Follow Night Light",      IDM_MODE_NIGHTLIGHT
        END
        MENUITEM SEPARATOR
        MENUITEM "Open Settings...",            IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        IDM_EXIT
    END
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 260, 220
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LightSwitch Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Schedule mode:", IDC_STATIC, 10, 12, 80, 10
    COMBOBOX        IDC_MODE_COMBO, 95, 10, 155, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Light time (HH:MM):", IDC_STATIC, 10, 34, 80, 10
    EDITTEXT        IDC_LIGHT_TIME, 95, 32, 50, 14, ES_AUTOHSCROLL

    LTEXT           "Dark time (HH:MM):", IDC_STATIC, 10, 54, 80, 10
    EDITTEXT        IDC_DARK_TIME, 95, 52, 50, 14, ES_AUTOHSCROLL

    LTEXT           "Sunrise offset (min):", IDC_STATIC, 10, 74, 80, 10
    EDITTEXT        IDC_SUNRISE_OFFSET, 95, 72, 50, 14, ES_AUTOHSCROLL

    LTEXT           "Sunset offset (min):", IDC_STATIC, 10, 94, 80, 10
    EDITTEXT        IDC_SUNSET_OFFSET, 95, 92, 50, 14, ES_AUTOHSCROLL

    LTEXT           "Latitude:", IDC_STATIC, 10, 114, 80, 10
    EDITTEXT        IDC_LATITUDE, 95, 112, 70, 14, ES_AUTOHSCROLL

    LTEXT           "Longitude:", IDC_STATIC, 10, 134, 80, 10
    EDITTEXT        IDC_LONGITUDE, 95, 132, 70, 14, ES_AUTOHSCROLL

    AUTOCHECKBOX    "Change system theme", IDC_CHANGE_SYSTEM, 10, 156, 120, 10
    AUTOCHECKBOX    "Change apps theme", IDC_CHANGE_APPS, 140, 156, 110, 10

    LTEXT           "Toggle hotkey:", IDC_STATIC, 10, 178, 80, 10
    CONTROL         "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 95, 176, 100, 14

    DEFPUSHBUTTON   "Save", IDOK, 140, 198, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 198, 50, 16
END
